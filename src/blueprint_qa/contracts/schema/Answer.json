{
  "$defs": {
    "AnswerStatus": {
      "enum": [
        "ANSWERED",
        "CANNOT_ANSWER",
        "NEEDS_CLARIFICATION",
        "UNSUPPORTED_QUESTION"
      ],
      "title": "AnswerStatus",
      "type": "string"
    }
  },
  "properties": {
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "evidence": {
      "items": {
        "type": "string"
      },
      "title": "Evidence",
      "type": "array"
    },
    "explanation": {
      "title": "Explanation",
      "type": "string"
    },
    "language": {
      "title": "Language",
      "type": "string"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/AnswerStatus"
    },
    "unit": {
      "enum": [
        "count",
        "ratio",
        "boolean",
        "m",
        "m2",
        "m3",
        "ft",
        "ft2",
        "ft3"
      ],
      "title": "Unit",
      "type": "string"
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Value"
    }
  },
  "required": [
    "request_id",
    "status",
    "value",
    "unit",
    "confidence",
    "evidence",
    "explanation",
    "language"
  ],
  "title": "Answer",
  "type": "object"
}
