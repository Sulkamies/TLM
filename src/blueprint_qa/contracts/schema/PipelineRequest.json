{
  "$defs": {
    "InputFormat": {
      "enum": [
        "PNG",
        "JPEG",
        "PDF",
        "IFC"
      ],
      "title": "InputFormat",
      "type": "string"
    }
  },
  "properties": {
    "filename": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Filename"
    },
    "input_bytes": {
      "format": "base64url",
      "title": "Input Bytes",
      "type": "string"
    },
    "input_format": {
      "$ref": "#/$defs/InputFormat"
    },
    "locale_hint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Locale Hint"
    },
    "question": {
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "received_at": {
      "format": "date-time",
      "title": "Received At",
      "type": "string"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "validation_token": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Validation Token"
    }
  },
  "required": [
    "request_id",
    "input_bytes",
    "input_format",
    "question",
    "received_at"
  ],
  "title": "PipelineRequest",
  "type": "object"
}
