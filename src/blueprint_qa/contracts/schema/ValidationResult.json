{
  "$defs": {
    "InputFormat": {
      "enum": [
        "PNG",
        "JPEG",
        "PDF",
        "IFC"
      ],
      "title": "InputFormat",
      "type": "string"
    },
    "PlanImage": {
      "properties": {
        "height_px": {
          "title": "Height Px",
          "type": "integer"
        },
        "image_png": {
          "format": "base64url",
          "title": "Image Png",
          "type": "string"
        },
        "width_px": {
          "title": "Width Px",
          "type": "integer"
        }
      },
      "required": [
        "image_png",
        "width_px",
        "height_px"
      ],
      "title": "PlanImage",
      "type": "object"
    },
    "ValidationReason": {
      "enum": [
        "OK",
        "NOT_A_BLUEPRINT",
        "FORMAT_MISMATCH",
        "UNREADABLE",
        "NO_SPATIAL_DATA",
        "MULTI_PAGE_PDF",
        "LOW_CONFIDENCE"
      ],
      "title": "ValidationReason",
      "type": "string"
    }
  },
  "properties": {
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "ifc_bytes": {
      "anyOf": [
        {
          "format": "base64url",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Ifc Bytes"
    },
    "ifc_schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Ifc Schema"
    },
    "input_format": {
      "$ref": "#/$defs/InputFormat"
    },
    "is_valid": {
      "title": "Is Valid",
      "type": "boolean"
    },
    "plan_image": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlanImage"
        },
        {
          "type": "null"
        }
      ]
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "reason": {
      "$ref": "#/$defs/ValidationReason"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "is_valid",
    "reason",
    "confidence",
    "input_format",
    "provider",
    "plan_image",
    "ifc_bytes",
    "ifc_schema"
  ],
  "title": "ValidationResult",
  "type": "object"
}
