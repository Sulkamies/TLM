# Copy to .env and fill in. Never commit .env.
# Google Gemini API key (used by src/blueprint_qa/common/llm.py; see docs/EXTERNAL_SERVICES.md)
GEMINI_API_KEY=
# Optional overrides
# BP_CONFIG_DIR=          # directory holding default.yaml and llm.yaml (default: <repo>/config)
# BP_LLM_PROVIDER=        # force every component's provider: "gemini" or "mock"
# BP_LLM_CASSETTE_DIR=    # directory of recorded LLM responses for provider "mock"
# BP_LLM_RECORD=          # "1" = record real Gemini responses into BP_LLM_CASSETTE_DIR
# BP_LOG_LEVEL=           # default INFO
